10 REM GRAPHISMES DU X-07 : 120 x 32 POINTS
20 CLS
30 REM CARACTERES REDEFINIS : 8 LIGNES DE 6 POINTS (BIT 7 A GAUCHE)
40 FONT$(128)="&H50,&HF8,&HF8,&H70,&H20,0,0,0"
50 FONT$(129)="&H20,&H70,&H70,&HF8,&HA8,0,0,0"
60 REM CADRE
70 LINE(0,0)-(119,0):LINE(119,0)-(119,31)
80 LINE(119,31)-(0,31):LINE(0,31)-(0,0)
90 REM TEXTE : IL PARTAGE L'ECRAN AVEC LES POINTS
100 LOCATE 2,1:PRINT "CANON X-07";
110 LOCATE 2,2:PRINT CHR$(128);" ";CHR$(129);" ";CHR$(128);
120 REM CERCLES CONCENTRIQUES
130 FOR R=2 TO 14 STEP 4:CIRCLE(96,15),R:NEXT
140 REM SINUSOIDE POINT PAR POINT
150 FOR X=2 TO 78:PSET(X,27+3*SIN(X/4)):NEXT
160 REM POINT VOIT AUSSI LE TEXTE
170 IF POINT(96,15)=0 THEN PSET(96,15)
180 IF INKEY$="" THEN 180
