10 REM *** SERPENT POUR CANON X-07 ***
20 CLS: CLEAR ': CONSOLE 0,4,0,1,0
30 REM CORPS DANS UN TAMPON CIRCULAIRE : QUEUE EN T, TETE EN H
40 M=128: DIM X(127),Y(127): L=5: T=0: H=L-1: G=0: DX=1: DY=0: SC=0
50 FOR I=0 TO L-1: X(I)=16+I: Y(I)=16: PSET(X(I),Y(I)): NEXT I
60 GOSUB 300
70 K$=INKEY$: IF K$="" THEN 120
80 IF K$=CHR$(28) AND DX=0 THEN DX=1: DY=0: REM DROITE
90 IF K$=CHR$(29) AND DX=0 THEN DX=-1: DY=0: REM GAUCHE
100 IF K$=CHR$(30) AND DY=0 THEN DX=0: DY=-1: REM HAUT
110 IF K$=CHR$(31) AND DY=0 THEN DX=0: DY=1: REM BAS
120 NX=X(H)+DX: NY=Y(H)+DY
130 IF NX<0 OR NX>119 OR NY<0 OR NY>31 THEN 400
140 F=0: IF NX=PX AND NY=PY THEN F=1: SC=SC+10: G=G+2
150 REM LA QUEUE AVANCE, SAUF SI LE SERPENT GRANDIT
160 IF G>0 AND L<M-1 THEN G=G-1: L=L+1: GOTO 180
170 PRESET(X(T),Y(T)): T=T+1: IF T=M THEN T=0
180 IF F=0 AND POINT(NX,NY)<>0 THEN 400: REM IL SE MORD
190 H=H+1: IF H=M THEN H=0
200 X(H)=NX: Y(H)=NY: PSET(NX,NY)
210 IF F THEN GOSUB 300
220 GOTO 70
300 REM POMME, HORS DU SERPENT
310 PX=INT(RND(1)*110)+5: PY=INT(RND(1)*26)+3
320 IF POINT(PX,PY)<>0 THEN 310
330 PSET(PX,PY): RETURN
400 CLS
410 PRINT "GAME OVER !"
420 PRINT "SCORE :";SC
430 IF INKEY$<>"" THEN 430
440 PRINT "REJOUER (O/N) ?"
450 K$=INKEY$: IF K$="O" OR K$="o" THEN GOTO 20
460 IF K$="N" OR K$="n" THEN END
470 GOTO 450
