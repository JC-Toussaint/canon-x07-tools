                    188  ; ------------------------------------------------ bibliothèque
                    189  
1E60                190  RT_END:
1E60  2A D7 1F      191          LD   HL,(RT_HSAV)       ; rétablit le crochet d'erreur ($00AB)
1E63  22 AB 00      192          LD   (HKERROR),HL
1E66  3A D9 1F      193          LD   A,(RT_HSAV+2)
1E69  32 AD 00      194          LD   (HKERROR+2),A
1E6C  ED 7B D5 1F   195          LD   SP,(RT_SP)
1E70  FD E1         196          POP  IY
1E72  DD E1         197          POP  IX
1E74  E1            198          POP  HL
1E75  D1            199          POP  DE
1E76  C1            200          POP  BC
1E77  F1            201          POP  AF
1E78  C9            202          RET                     ; retour au BASIC (EXEC)
                    203  
1E79                204  RT_FERR:                        ; erreur numéro E (crochet $00AB de la ROM ou bibliothèque)
1E79  3A B9 00      205          LD   A,(CSRX)
1E7C  3D            206          DEC  A
1E7D  C4 29 E9      207          CALL NZ,CRLF            ; à la ligne si le curseur n'est pas en colonne 1
1E80  7B            208          LD   A,E
1E81  3D            209          DEC  A
1E82  87            210          ADD  A,A
1E83  6F            211          LD   L,A
1E84  26 00         212          LD   H,0
1E86  11 23 F1      213          LD   DE,ERRTAB          ; codes sur deux lettres, comme le X-07
1E89  19            214          ADD  HL,DE
1E8A  7E            215          LD   A,(HL)
1E8B  EF            216          RST  $28
1E8C  23            217          INC  HL
1E8D  7E            218          LD   A,(HL)
1E8E  EF            219          RST  $28
1E8F  21 AE 1E      220          LD   HL,MSG_ERR
1E92  CD F8 1E      221          CALL RT_PRS
1E95  CD 29 E9      222          CALL CRLF
1E98  C3 60 1E      223          JP   RT_END
                    224  
1E9B                225  RT_BREAK:                       ; arrêt par BREAK : « Break », comme le X-07
1E9B  3A B9 00      226          LD   A,(CSRX)
1E9E  3D            227          DEC  A
1E9F  C4 29 E9      228          CALL NZ,CRLF
1EA2  21 B5 1E      229          LD   HL,MSG_BRK
1EA5  CD F8 1E      230          CALL RT_PRS
1EA8  CD 29 E9      231          CALL CRLF
1EAB  C3 60 1E      232          JP   RT_END
                    233  
1EAE  06 20 45 72   234  MSG_ERR:    DB 6," Error"
1EB2  72 6F 72   
                    235  
1EB5  05 42 72 65   236  MSG_BRK:    DB 5,"Break"
1EB9  61 6B      
                    237  
1EBB                238  RT_BRK:                         ; comme l'interpréteur ($C000) : OFF, pause, piles, BREAK
1EBB  3A 2B 00      239          LD   A,(BRKFLG)
1EBE  B7            240          OR   A
1EBF  C8            241          RET  Z                  ; cas courant : rien à faire
1EC0  E5            242          PUSH HL
1EC1  D5            243          PUSH DE
1EC2  C5            244          PUSH BC
1EC3  CD A6 C5      245          CALL CHKBATT            ; bit 7 : extinction demandée
1EC6  CB 57         246          BIT  2,A                ; bit 2 : pause jusqu'à une touche
1EC8  28 13         247          JR   Z,.P
1ECA  CB 97         248          RES  2,A
1ECC  32 2B 00      249          LD   (BRKFLG),A
1ECF  CD BD C0      250          CALL T6FLUSH
1ED2  CD 0A C9      251  .W:     CALL INKEY
1ED5  20 06         252          JR   NZ,.P
1ED7  3A 2B 00      253          LD   A,(BRKFLG)
1EDA  B7            254          OR   A
1EDB  28 F5         255          JR   Z,.W
1EDD  CD 6C C0      256  .P:     CALL BATTMSG            ; bits 1 et 3 : piles faibles
1EE0  3A 2B 00      257          LD   A,(BRKFLG)
1EE3  0F            258          RRCA                    ; bit 0 : BREAK
1EE4  38 04         259          JR   C,.B
1EE6  C1            260          POP  BC
1EE7  D1            261          POP  DE
1EE8  E1            262          POP  HL
1EE9  C9            263          RET
1EEA  3A 2B 00      264  .B:     LD   A,(BRKFLG)
1EED  E6 FA         265          AND  $FA
1EEF  32 2B 00      266          LD   (BRKFLG),A
1EF2  CD BD C0      267          CALL T6FLUSH
1EF5  C3 9B 1E      268          JP   RT_BREAK
                    269  
1EF8                270  RT_PRS:                         ; affiche la chaîne (HL) sur le périphérique courant
1EF8  46            271          LD   B,(HL)
1EF9  04            272          INC  B
1EFA  05            273  .L:     DEC  B
1EFB  C8            274          RET  Z
1EFC  23            275          INC  HL
1EFD  7E            276          LD   A,(HL)
1EFE  EF            277          RST  $28
1EFF  18 F9         278          JR   .L
                    279  
1F01                280  RT_PRNUM:                       ; PRINT d'un nombre (FAC), copie de la ROM ($EA2C)
1F01  CD AB BB      281          CALL FOUT               ; HL = texte terminé par 00
1F04  E5            282          PUSH HL
1F05  06 01         283          LD   B,1                ; longueur + espace final
1F07  7E            284  .C:     LD   A,(HL)
1F08  B7            285          OR   A
1F09  28 04         286          JR   Z,.D
1F0B  23            287          INC  HL
1F0C  04            288          INC  B
1F0D  18 F8         289          JR   .C
1F0F  C5            290  .D:     PUSH BC
1F10  01 00 FF      291          LD   BC,$FF00
1F13  CD EE E8      292          CALL DEVPOS             ; A = position, B = largeur
1F16  D1            293          POP  DE                 ; D = longueur
1F17  A7            294          AND  A
1F18  28 06         295          JR   Z,.P
1F1A  82            296          ADD  A,D
1F1B  3D            297          DEC  A
1F1C  B8            298          CP   B
1F1D  D4 29 E9      299          CALL NC,CRLF            ; ne tient pas sur la ligne
1F20  E1            300  .P:     POP  HL
1F21  7E            301  .O:     LD   A,(HL)
1F22  B7            302          OR   A
1F23  28 04         303          JR   Z,.S
1F25  EF            304          RST  $28
1F26  23            305          INC  HL
1F27  18 F8         306          JR   .O
1F29  3E 20         307  .S:     LD   A,' '
1F2B  EF            308          RST  $28
1F2C  C9            309          RET
