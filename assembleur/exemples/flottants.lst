                      1  ; FLOTTANTS - compilé par x07basic (BASIC du Canon X-07)
                      2  ; Chargement : CLEAR 50,&H1CEF  puis  EXEC &H1CF0
                      3  
0050                  4  STRCAP  EQU  80               ; capacité des chaînes
                      5  
                      6  ; Canon X-07 : routines de la ROM
B5AC                  7  FATN     EQU  $B5AC  ; ATN (vérifié ROM)
B694                  8  FSQR     EQU  $B694  ; SQR (vérifié ROM)
BBAB                  9  FOUT     EQU  $BBAB  ; FAC -> texte libre, HL = début, fin 00 (vérifié ROM)
C06C                 10  BATTMSG  EQU  $C06C  ; messages piles faibles (BREAKFLAG bits 1 et 3) (vérifié ROM)
C0BD                 11  T6FLUSH  EQU  $C0BD  ; vide les tampons clavier et T6834
C5A6                 12  CHKBATT  EQU  $C5A6  ; si BREAKFLAG bit 7 (OFF) : éteint la machine (vérifié ROM)
C90A                 13  INKEY    EQU  $C90A  ; lit une touche (INKEY$) -> A ; Z=1 si aucune (vérifié ROM)
CAD9                 14  DCMP     EQU  $CAD9  ; compare acc et acc2 (double)
CAEF                 15  HL2FAC   EQU  $CAEF  ; HL -> accumulateur (entier)
CB08                 16  FCSNG    EQU  $CB08  ; accumulateur -> simple précision (CSNG)
CB90                 17  FCDBL    EQU  $CB90  ; accumulateur -> double précision (CDBL)
CE9E                 18  LCDCLS   EQU  $CE9E  ; efface l'écran (CLS)
E8EE                 19  DEVPOS   EQU  $E8EE  ; position (A) et largeur (B) du périphérique courant (vérifié ROM)
E929                 20  CRLF     EQU  $E929  ; envoie CR LF au périphérique courant (vérifié ROM)
F123                 21  ERRTAB   EQU  $F123  ; codes d'erreur sur 2 lettres : NF SN RG OD FC OV... (vérifié ROM)
F9E4                 22  FOPDISP  EQU  $F9E4  ; répartiteur des opérateurs + - * / ^ (pile : opérande gauche, BC = type/op) (vérifié ROM)
                     23  
                     24  ; Canon X-07 : variables système
002B                 25  BRKFLG   EQU  $002B  ; BREAKFLAG
00AB                 26  HKERROR  EQU  $00AB  ; hook ERREUR
00B9                 27  CSRX     EQU  $00B9  ; colonne du curseur, à partir de 1 (vérifié ROM)
01D9                 28  VALTYP   EQU  $01D9  ; type de donnée (2,3,4,8)
044E                 29  FAC      EQU  $044E  ; accumulateur flottant
0450                 30  FACINT   EQU  $0450  ; entier dans l'accumulateur
049F                 31  ARG      EQU  $049F  ; accumulateur 2
                     32  
1CF0                 33          ORG  $1CF0
                     34  
1CF0  F5             35  START:  PUSH AF                  ; sauvegarde pour le retour au BASIC
1CF1  C5             36          PUSH BC
1CF2  D5             37          PUSH DE
1CF3  E5             38          PUSH HL
1CF4  DD E5          39          PUSH IX
1CF6  FD E5          40          PUSH IY
1CF8  ED 73 D5 1F    41          LD   (RT_SP),SP
