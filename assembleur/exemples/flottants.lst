1CFF  22 D7 1F       43          LD   (RT_HSAV),HL
1D02  3A AD 00       44          LD   A,(HKERROR+2)
1D05  32 D9 1F       45          LD   (RT_HSAV+2),A
1D08  3E C3          46          LD   A,$C3               ; JP RT_FERR
1D0A  32 AB 00       47          LD   (HKERROR),A
1D0D  21 79 1E       48          LD   HL,RT_FERR
1D10  22 AC 00       49          LD   (HKERROR+1),HL
