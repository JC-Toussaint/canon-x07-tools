' Journal : chaque lancement ajoute une note dans un fichier en RAM du X-07,
' puis réaffiche toutes les notes.  Le fichier survit à l'extinction (OFF).
' Sur PC :  python3 x07asm.py emu exemples/qbasic/journal.qbas --memoire x07.mem
' ou dans l'éditeur : python3 x07asm.py ide exemples/qbasic/journal.qbas (▶, ↺, ▶...)
DEFINT A-Z

CLS
LINE INPUT "Note : "; note$
OPEN "notes" FOR APPEND AS #1 LEN = 400   ' créé au premier lancement
PRINT #1, note$
CLOSE #1

CLS
n = 0
OPEN "notes" FOR INPUT AS #1
DO WHILE NOT EOF(1)
    LINE INPUT #1, ligne$
    n = n + 1
    PRINT n; ligne$
LOOP
CLOSE #1
PRINT n; "note(s)";
SLEEP
END
